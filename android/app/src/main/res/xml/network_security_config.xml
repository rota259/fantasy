<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS بس، وبشهادات النظام بس (شهادات اليوزر — اللي أدوات التجسس على الشبكة بتركّبها — مش مقبولة) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
